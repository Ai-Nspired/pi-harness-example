{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pi-harness-example",
  "main": "src/server.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI", "remote": true },
  // Optional: prefer a SearXNG instance with "json" in `search.formats`.
  // Empty searches through DuckDuckGo instead.
  "vars": { "SEARXNG_URL": "" },
  // `exec` runs JavaScript in Dynamic Workers minted through this.
  "worker_loaders": [{ "binding": "LOADER" }],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/agents/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PiAgent",
        "class_name": "PiAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PiAgent"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
