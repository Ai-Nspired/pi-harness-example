{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pi-harness-example",
  "main": "src/server.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI", "remote": true },
  // Our own SearXNG instance (Render), which serves the JSON API. Searches
  // go here first, so they do not depend on engines that block Cloudflare.
  "vars": {
    "SEARXNG_URL": "https://searing-render.onrender.com",
    // When SearXNG is asleep or down, search Ceramic.ai through Cloudflare's
    // Web Search API: $0.25 per 1,000 searches, paid from AI Gateway credits.
    // It never runs while the instance above answers. Set to "off" to disable.
    "CLOUDFLARE_SEARCH": "on",
    "AI_GATEWAY_ID": "default",
    // OpenRouter presets you create in the dashboard, as slugs. Each becomes
    // the model `openrouter/@preset/<slug>`. OPENROUTER_API_KEY is a secret,
    // set in the dashboard, never here.
    "OPENROUTER_PRESETS": "truth, doc, micro, mnl, operator",
    "OPENROUTER_DEFAULT_PRESET": "truth",
    // Route on price, never on luck: OpenRouter picks the cheapest provider
    // that serves the model. Same model, up to 2.7x difference between them.
    "OPENROUTER_SORT": "price",
    // Hard ceiling in USD per million tokens, prompt then completion. A request
    // that cannot be served under it fails visibly instead of billing a
    // pricier route (Z.ai is $0.15/$0.50, Wafer $0.054/$0.20).
    "OPENROUTER_MAX_PRICE": "0.12,0.40",
    "OPENROUTER_PROVIDER_ORDER": "",
    "OPENROUTER_MODEL": "z-ai/glm-5.3-flash"
  },
  // Real Chromium for web search, so a rate-limited page can still be read.
  // Needs the Workers Paid plan.
  "browser": { "binding": "BROWSER" },
  // `exec` runs JavaScript in Dynamic Workers minted through this.
  "worker_loaders": [{ "binding": "LOADER" }],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/agents/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PiAgent",
        "class_name": "PiAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PiAgent"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
